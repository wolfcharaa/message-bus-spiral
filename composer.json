{
    "name": "romanfedorskij/message-bus-spiral",
    "description": "Message bus adapter for Spiral Framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "romanfedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "spiral/framework": "^3.16",
        "spiral/roadrunner-bridge": "^3.8 || ^4.0",
        "romanfedorskij/message-bus": "^5.1",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Wolfcharaa\\MessageBus\\Spiral\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wolfcharaa\\MessageBus\\Spiral\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "config": {
        "allow-plugins": {
            "spiral/composer-publish-plugin": true
        }
    }
}
